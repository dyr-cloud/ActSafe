OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_TEE_DATA_ROOT=
ASB_OFFICIAL_TEST_FILE=
DOJO_TEST_FILE=
DOJO_TOOLS_FILE=
DOJO_ENVIRONMENTS_FILE=
DOJO_INJECTION_VECTORS_FILE=
INJECAGENT_INPUT_FILE=
INJECAGENT_TOOLS_FILE=
# Host-visible Occlum instance. The protected image is ${OCCLUM_IMAGE_ROOT}.
OCCLUM_IMAGE_ROOT=/host/image
OCCLUM_BIN=occlum
TEE_AUDITOR_TIMEOUT=120

# Required only while preparing the measured image. These files are copied
# into /host/image and are never loaded by the untrusted benchmark process.
AUDITOR_MODEL_SOURCE=/path/to/models--prajjwal1--bert-tiny/snapshots/6f75de8b60a9f8a2fdf7b69cbd86d9e64bcb3837
SPACY_MODEL_SOURCE=/path/to/en_core_web_sm
ASB_AUDITOR_WEIGHTS="$PWD/checkpoints/asb/checker_tinybert_17b.pth"
DOJO_AUDITOR_WEIGHTS="$PWD/checkpoints/dojo/checker_tinybert_17b.pth"
INJECAGENT_AUDITOR_WEIGHTS="$PWD/checkpoints/injectagent/checker_tinybert_injecagent.pth"
